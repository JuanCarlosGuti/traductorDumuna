# Copy to .env and fill in your own values. Never commit .env.

# Translator — any OpenAI-compatible API (Groq shown)
TRADUCTOR_BASE_URL=https://api.groq.com/openai/v1
TRADUCTOR_MODELO=openai/gpt-oss-120b
TRADUCTOR_API_KEY=YOUR_API_KEY_HERE

# Or the Anthropic API (takes priority when set)
# ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
# ANTHROPIC_ESFUERZO=low

# Single-user auth (required in production)
AUTH_USUARIO=admin
AUTH_PASSWORD=CHANGE_ME
AUTH_JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_32
