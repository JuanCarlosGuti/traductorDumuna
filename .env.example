# Copy to .env and fill in your own values. Never commit .env.

# Translator — any OpenAI-compatible API (Groq shown)
TRANSLATOR_BASE_URL=https://api.groq.com/openai/v1
TRANSLATOR_MODEL=openai/gpt-oss-120b
TRANSLATOR_API_KEY=YOUR_API_KEY_HERE

# Or the Anthropic API (takes priority when set)
# ANTHROPIC_API_KEY=YOUR_API_KEY_HERE
# ANTHROPIC_EFFORT=low

# Single-user auth (required in production)
AUTH_USERNAME=admin
AUTH_PASSWORD=CHANGE_ME
AUTH_JWT_SECRET=GENERATE_WITH_openssl_rand_-hex_32
