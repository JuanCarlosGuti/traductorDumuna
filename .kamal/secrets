# References to the secrets, NOT their values. This file IS VERSIONED: if it
# were in .gitignore, the deployment would fail because Kamal cannot find it
# inside the GitHub Actions runner.
#
# Each name has to exist as a repository secret
# (Settings -> Secrets and variables -> Actions) and be exported in the deploy
# job. Secrets are per repository: they are not inherited from the other
# projects on the same server. No value ever goes through the chat or the repo.

# GHCR token. It does NOT need to be created: the workflow exports it from
# ${{ secrets.GITHUB_TOKEN }}, which GitHub generates on every run.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Anthropic key: Claude is the main engine (the same one Render uses).
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY

# Groq key, the fallback (the same one Render uses).
TRANSLATOR_API_KEY=$TRANSLATOR_API_KEY

# The app's single username and password.
AUTH_USERNAME=$AUTH_USERNAME
AUTH_PASSWORD=$AUTH_PASSWORD

# Session signing: `openssl rand -hex 32` or
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=$AUTH_JWT_SECRET
