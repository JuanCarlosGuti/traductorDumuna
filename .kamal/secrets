# Referencias a los secretos, NO sus valores. Este archivo SE VERSIONA: si
# estuviera en .gitignore, el despliegue falla porque Kamal no lo encuentra
# dentro del runner de GitHub Actions.
#
# Cada nombre tiene que existir como secreto del repositorio
# (Settings -> Secrets and variables -> Actions) y estar exportado en el job
# de despliegue. Los secretos son por repositorio: no se heredan de los otros
# proyectos del mismo servidor. Ningún valor pasa por el chat ni por el repo.

# Token de GHCR. NO hay que crearlo: el workflow lo exporta desde
# ${{ secrets.GITHUB_TOKEN }}, que GitHub genera en cada ejecución.
KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD

# Clave de Anthropic: Claude es el motor principal (la misma que usa Render).
ANTHROPIC_API_KEY=$ANTHROPIC_API_KEY

# Clave de Groq, el respaldo (la misma que usa Render).
TRADUCTOR_API_KEY=$TRADUCTOR_API_KEY

# Usuario y contraseña únicos de la app.
AUTH_USUARIO=$AUTH_USUARIO
AUTH_PASSWORD=$AUTH_PASSWORD

# Firma de las sesiones: `openssl rand -hex 32` o
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_JWT_SECRET=$AUTH_JWT_SECRET
